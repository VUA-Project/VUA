{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/schemas/scenario-environment/v0.1/result.schema.json",
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "desktop_play",
              "pico_pcvr",
              "pc_avatar",
              "quest_avatar"
            ]
          }
        },
        "editorRoot": {
          "type": "string",
          "minLength": 4,
          "maxLength": 240,
          "pattern": "^[A-Za-z]:\\\\[^\\u0000-\\u001f]*$"
        },
        "useMirrors": {
          "type": "boolean"
        },
        "picoRegion": {
          "enum": [
            "china_mainland",
            "other"
          ]
        }
      },
      "required": [
        "purposes",
        "editorRoot"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "vua.scenario-environment/v0.1"
        },
        "scenario": {
          "enum": [
            "desktop_play",
            "pico_pcvr",
            "pc_avatar",
            "quest_avatar"
          ]
        },
        "connection": {
          "enum": [
            "usb",
            "wifi",
            null
          ]
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "expectedResult": {
                "type": "string",
                "minLength": 1
              },
              "automatic": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "explanation",
              "expectedResult",
              "automatic"
            ]
          }
        },
        "performed": {
          "const": "sop_only"
        },
        "nextAction": {
          "const": "check_environment"
        },
        "licenseRequiredFor": {
          "enum": [
            "none",
            "editor_execution"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "scenario",
        "connection",
        "requirements",
        "steps",
        "performed",
        "nextAction",
        "licenseRequiredFor"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "vua.scenario-environment/v0.1"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "component": {
                "enum": [
                  "steam",
                  "vrchat",
                  "steamvr",
                  "pico_runtime",
                  "unity_editor",
                  "android_modules"
                ]
              },
              "presence": {
                "enum": [
                  "verified",
                  "missing",
                  "unsuitable",
                  "detection_failed"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "component",
              "presence",
              "location",
              "version"
            ]
          }
        },
        "softwareReady": {
          "type": "boolean"
        },
        "licenseState": {
          "const": "not_checked"
        },
        "performed": {
          "const": "software_check_only"
        },
        "nextAction": {
          "enum": [
            "follow_sop",
            "plan_installation"
          ]
        },
        "installationStarted": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "intent",
        "observations",
        "softwareReady",
        "licenseState",
        "performed",
        "nextAction",
        "installationStarted"
      ]
    }
  ]
}
