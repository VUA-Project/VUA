{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/library-records/v0.1/response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "entryIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
      }
    }
  }
}
