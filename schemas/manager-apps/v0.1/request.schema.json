{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "correlationId",
    "kind",
    "method",
    "params"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "query"
    },
    "method": {
      "const": "environment.inspectManagerApps"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
