{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/manager-apps/v0.2/open-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "correlationId",
    "kind",
    "method",
    "commandId",
    "params"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "command"
    },
    "method": {
      "const": "environment.openManagerApp"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managerId"
      ],
      "properties": {
        "managerId": {
          "enum": [
            "unity_hub",
            "vcc",
            "alcom"
          ]
        }
      }
    }
  }
}
