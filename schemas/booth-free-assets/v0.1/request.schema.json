{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/booth-free-assets/v0.1/request.schema.json",
  "$defs": {
    "keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "categoryId": {
      "type": "string",
      "enum": ["209", "230", "231", "217", "214", "215", "216", "127"]
    },
    "boothProductId": {
      "type": "string",
      "pattern": "^booth:[1-9][0-9]{0,19}$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "query" },
        "method": { "const": "freeAssets.state" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "const": "0.1" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "commandId", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "command" },
        "method": { "const": "freeAssets.updatePreferences" },
        "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "minProperties": 2,
          "properties": {
            "schemaVersion": { "const": "0.1" },
            "watchedKeywords": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["keyword", "enabled"],
                "properties": {
                  "keyword": { "$ref": "#/$defs/keyword" },
                  "enabled": { "type": "boolean" }
                }
              }
            },
            "enabledCategories": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/categoryId" }
            },
            "hideOwned": { "type": "boolean" },
            "showSamples": { "type": "boolean" },
            "dismissProductId": { "$ref": "#/$defs/boothProductId" },
            "clearDismissed": { "type": "boolean" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "commandId", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "command" },
        "method": { "const": "freeAssets.ingestSearchPage" },
        "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "keyword", "sourceUrl", "html", "fetchedAt", "resetCache"],
          "properties": {
            "schemaVersion": { "const": "0.1" },
            "keyword": { "$ref": "#/$defs/keyword" },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://booth\\.pm/ja/browse/3D%E3%83%A2%E3%83%87%E3%83%AB\\?q=[^&#]+&max_price=0&sort=new&in_stock=true$"
            },
            "html": { "type": "string", "minLength": 1, "maxLength": 5000000 },
            "fetchedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,9})?Z$"
            },
            "resetCache": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
