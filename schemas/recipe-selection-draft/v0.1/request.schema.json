{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/recipe-selection-draft/v0.1/request.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "displayName",
        "source"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "source": {
          "enum": [
            "cloud",
            "local"
          ]
        },
        "variantName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "shopName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "warehouseItemId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "cloud"
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "pattern": "^booth:[0-9]+$"
              },
              "warehouseItemId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "recipeDraft.list"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "enum": [
            "recipeDraft.get",
            "recipeDraft.selectionStatus"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "draftId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "draftId": {
              "type": "string",
              "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "recipeDraft.save"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "draftId",
            "title",
            "baseRevision",
            "selections"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "draftId": {
              "type": "string",
              "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740990
            },
            "selections": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "$ref": "#/$defs/selection"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "recipeDraft.addSelection"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "draftId",
            "baseRevision",
            "selections"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "draftId": {
              "type": "string",
              "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
            },
            "baseRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740990
            },
            "selections": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "$ref": "#/$defs/selection"
              }
            }
          }
        }
      }
    }
  ]
}
