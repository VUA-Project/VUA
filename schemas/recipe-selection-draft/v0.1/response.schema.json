{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/recipe-selection-draft/v0.1/response.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "displayName",
        "source"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "source": {
          "enum": [
            "cloud",
            "local"
          ]
        },
        "variantName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "shopName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "warehouseItemId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "cloud"
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "pattern": "^booth:[0-9]+$"
              },
              "warehouseItemId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "draftId",
        "kind",
        "title",
        "createdAt",
        "selections"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "draftId": {
          "type": "string",
          "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
        },
        "kind": {
          "const": "selection_draft"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "selections": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/selection"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "document",
        "revision",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "addedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "existingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        }
      },
      "dependentRequired": {
        "addedCount": [
          "existingCount"
        ],
        "existingCount": [
          "addedCount"
        ]
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "entries"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "draftId",
              "title",
              "revision",
              "updatedAt",
              "selectionCount"
            ],
            "properties": {
              "draftId": {
                "type": "string",
                "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "\\S"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "selectionCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 512
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "draftId",
        "revision",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "draftId": {
          "type": "string",
          "pattern": "^recipe-draft-[A-Za-z0-9_-]{1,100}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "storedCopies",
              "presentCopies",
              "state"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "storedCopies": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "presentCopies": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "state": {
                "enum": [
                  "present",
                  "missing",
                  "not_stored"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
