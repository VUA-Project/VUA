{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/library-view/v0.1/response.schema.json",
  "$comment": "Catalog presentation definitions are inherited unchanged from bdl-queries v0.7; current presence is owned by this new AMF read face.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "total",
        "offset",
        "limit",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "productId",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "productId": {
          "type": "string",
          "pattern": "^booth:[0-9]+$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/productFile"
          }
        }
      }
    }
  ],
  "$defs": {
    "productSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "title",
        "price",
        "imageUrl",
        "imageUrls",
        "availabilityRaw",
        "availabilityStatus",
        "entityCount",
        "entityTypes",
        "libraryType",
        "importedArtifacts",
        "shopName",
        "variantName"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^booth:[0-9]+$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "Always imageUrls[0] or null; carried by the vuaimg cache protocol."
        },
        "imageUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Verbatim observed source URLs (BOOTH properties)."
        },
        "availabilityRaw": {
          "type": [
            "string",
            "null"
          ],
          "description": "Verbatim observed word; never normalized for display or filtering."
        },
        "availabilityStatus": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "description": "Derived by the processor; the only field UI badges and filters consume."
        },
        "entityCount": {
          "const": 0,
          "description": "Honest empty slot in v0.2: entity storage is BDL v2."
        },
        "entityTypes": {
          "const": [],
          "description": "Honest empty slot in v0.2."
        },
        "libraryType": {
          "enum": [
            "bought",
            "gifts",
            "free_downloads",
            null
          ],
          "description": "BDL v0.3: which account library listed the product; null = unknown/legacy row."
        },
        "importedArtifacts": {
          "type": "integer",
          "minimum": 0,
          "description": "N5 D2: local artifacts correlated via artifact_mappings; 0 = cloud-only, >0 = imported."
        },
        "shopName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Shop display name from the library row observation; null = unknown."
        },
        "variantName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Purchased variant marker from the library row title suffix; null = not variant-differentiated."
        }
      }
    },
    "price": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Single-price products only; null = no price information (never guessed, never converted). Variant prices live in subproducts.",
      "properties": {
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "high": {
          "type": "string",
          "minLength": 1,
          "description": "Multi-variation price range upper bound (1400~2400's 2400); omitted for single-price products. Display uses the raw string, never numeric conversion."
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warehouseItemId",
        "folderName",
        "displayName",
        "kind",
        "createdAt",
        "artifacts",
        "artifactMode",
        "effectiveArtifactMode"
      ],
      "properties": {
        "warehouseItemId": {
          "type": "string",
          "minLength": 1
        },
        "folderName": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "imported_material",
            "downloaded_material"
          ],
          "description": "Closed entry-kind vocabulary (v0.3)."
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warehouseArtifactRef"
          }
        },
        "artifactMode": {
          "enum": [
            "use_original_unitypackage",
            "generate_vpm",
            null
          ],
          "description": "Per-entry consumption-preference override; null = follows the global default."
        },
        "effectiveArtifactMode": {
          "enum": [
            "use_original_unitypackage",
            "generate_vpm"
          ],
          "description": "Dynamically resolved at read time: override ?? the shell-level global default. A preference only — never a statement that a VPM exists."
        }
      }
    },
    "warehouseArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "artifactSha256",
        "state",
        "sizeBytes",
        "role"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "pending",
            "clean",
            "quarantined"
          ],
          "description": "Wire three-state mapped from the storage lifecycle: pending ← untrusted|inspected, clean ← admitted, quarantined ← rejected."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "original",
            "generated_vpm"
          ],
          "description": "Physical role within the entry: originals are removed by the delete-originals flow, generated VPM packages survive."
        }
      }
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "file": {
      "type": "object",
      "required": [
        "downloadableId",
        "fileName",
        "phase",
        "downloadId",
        "errorCode",
        "entryId",
        "copyId",
        "artifactSha256",
        "replaced"
      ],
      "additionalProperties": false,
      "properties": {
        "downloadableId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fileName": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "queued",
            "downloading",
            "downloaded",
            "inspecting",
            "stored",
            "failed",
            "cancelled",
            "unconfirmed"
          ]
        },
        "downloadId": {
          "$ref": "#/$defs/nullableText"
        },
        "errorCode": {
          "$ref": "#/$defs/nullableText"
        },
        "entryId": {
          "$ref": "#/$defs/nullableText"
        },
        "copyId": {
          "$ref": "#/$defs/nullableText"
        },
        "artifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "replaced": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "phase": {
            "const": "stored"
          }
        }
      },
      "then": {
        "properties": {
          "entryId": {
            "type": "string"
          },
          "copyId": {
            "type": "string"
          },
          "artifactSha256": {
            "type": "string"
          }
        }
      }
    },
    "downloadSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "batchId",
        "taskId",
        "productId",
        "revision",
        "state",
        "cancellationRequested",
        "recoveryDisposition",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "batchId": {
          "type": "string",
          "pattern": "^library-download-[A-Za-z0-9_.:-]{1,100}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^library-download-[A-Za-z0-9_.:-]{1,100}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^booth:[0-9]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "running",
            "succeeded",
            "succeeded_with_warnings",
            "failed",
            "cancelled"
          ]
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "recoveryDisposition": {
          "enum": [
            "none",
            "inspect_required"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "storedCopies",
        "presentCopies",
        "missingCopies",
        "changedCopies",
        "unreadableCopies",
        "supersededGeneratedCopies",
        "currentGeneratedCopies",
        "productionQualification"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "cloud_only",
            "present",
            "partial",
            "missing",
            "changed",
            "unreadable"
          ]
        },
        "storedCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "presentCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changedCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unreadableCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "productionQualification": {
          "const": "not_evaluated"
        },
        "supersededGeneratedCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentGeneratedCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "row": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "product",
            "sources",
            "storage",
            "operation"
          ],
          "properties": {
            "kind": {
              "const": "product"
            },
            "product": {
              "$ref": "#/$defs/productSummary"
            },
            "sources": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "bought",
                  "gifts",
                  "free_downloads"
                ]
              }
            },
            "storage": {
              "$ref": "#/$defs/storage"
            },
            "operation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/downloadSnapshot"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entry",
            "storage"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "entry": {
              "$ref": "#/$defs/entry"
            },
            "storage": {
              "$ref": "#/$defs/storage"
            }
          }
        }
      ]
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyId",
        "entryId",
        "fileName",
        "artifactSha256",
        "presence"
      ],
      "properties": {
        "copyId": {
          "type": "string",
          "minLength": 1
        },
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "presence": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "changed",
            "unreadable"
          ]
        }
      }
    },
    "productFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloadableId",
        "fileName",
        "managedCopyId",
        "copies"
      ],
      "properties": {
        "downloadableId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fileName": {
          "type": "string"
        },
        "managedCopyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "copies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/copy"
          }
        }
      }
    }
  }
}
