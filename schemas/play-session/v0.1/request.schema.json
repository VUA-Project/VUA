{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/play-session/v0.1/request.schema.json",
  "title": "Play session request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "correlationId",
    "kind",
    "method",
    "params"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "query",
        "command"
      ]
    },
    "method": {
      "enum": [
        "environment.observePlay",
        "environment.startPlay",
        "environment.stopPlay"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route"
      ],
      "properties": {
        "route": {
          "enum": [
            "desktop_play",
            "pico_pcvr"
          ]
        }
      }
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "environment.observePlay"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "query"
          }
        },
        "not": {
          "required": [
            "commandId"
          ]
        }
      },
      "else": {
        "properties": {
          "kind": {
            "const": "command"
          }
        },
        "required": [
          "commandId"
        ]
      }
    }
  ]
}
