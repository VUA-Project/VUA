{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/environment-deployment/v0.1/request.schema.json",
  "title": "Deployment v0.1 application parameters",
  "$comment": "Path semantics and the 240 UTF-8 byte bound are additionally enforced by the shared Rust/TypeScript intent validators. Intent vectors are the consumer parity suite.",
  "$defs": {
    "intent": {
      "type": "object", "additionalProperties": false, "required": ["purposes", "editorRoot"],
      "properties": {
        "purposes": {"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"enum":["desktop_play","pico_pcvr","pc_avatar","quest_avatar"]}},
        "editorRoot": {"type":"string","minLength":4,"maxLength":240,"pattern":"^[A-Za-z]:[\\\\/].+"},
        "useMirrors": {"type":"boolean","default":true},
        "picoRegion": {"enum":["china_mainland","other"]}
      }
    }
  },
  "oneOf": [
    {"type":"object","additionalProperties":false,"required":["intent"],"properties":{"intent":{"$ref":"#/$defs/intent"}}},
    {"type":"object","additionalProperties":false,"required":["intent","confirmedDigest"],"properties":{"intent":{"$ref":"#/$defs/intent"},"confirmedDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  ]
}
