{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.dev/schemas/amf-recipe/v0.4/recipe.schema.json",
  "title": "AMF production Recipe v0.4 (Candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "recipeId",
    "title",
    "editorVersion",
    "materials",
    "avatar",
    "outfits",
    "packages"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.4"
    },
    "recipeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "editorVersion": {
      "enum": [
        "2022.3.22f1",
        "2022.3.22f1c1"
      ]
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "packageName",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m-[a-f0-9]{64}$"
          },
          "packageName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+\\.[uU][nN][iI][tT][yY][pP][aA][cC][kK][aA][gG][eE]$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "prefabPath"
      ],
      "properties": {
        "materialId": {
          "type": "string",
          "pattern": "^m-[a-f0-9]{64}$"
        },
        "prefabPath": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^Assets/(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\:\\u0000])(?!.*//).+\\.prefab$"
        }
      }
    },
    "outfits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "materialId",
          "prefabPath",
          "mode",
          "bone",
          "toggleName",
          "active"
        ],
        "properties": {
          "materialId": {
            "type": "string",
            "pattern": "^m-[a-f0-9]{64}$"
          },
          "prefabPath": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^Assets/(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\:\\u0000])(?!.*//).+\\.prefab$"
          },
          "mode": {
            "enum": [
              "merge_armature",
              "attach_to_bone"
            ]
          },
          "bone": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          },
          "toggleName": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 64,
      "required": [
        "com.vrchat.avatars",
        "nadena.dev.modular-avatar"
      ],
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^(?=.*\\.)[a-zA-Z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9.+-]{1,80}$"
      }
    }
  }
}
