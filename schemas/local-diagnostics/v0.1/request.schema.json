{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/local-diagnostics/v0.1/request.schema.json",
  "title": "LocalDiagnosticsRequestV01",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "query" },
        "method": { "const": "diagnostics.observeLocal" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "const": "0.1" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "query" },
        "method": { "const": "diagnostics.diagnoseSymptom" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "symptom"],
          "properties": {
            "schemaVersion": { "const": "0.1" },
            "symptom": {
              "enum": [
                "audio_silent_or_wrong_mic",
                "osc_or_face_tracking_not_responding",
                "low_fps_or_vram_pressure",
                "disk_cache_full",
                "crash_or_eac_block",
                "avatar_hidden_or_grey_robot",
                "cannot_upload_avatar",
                "streaming_blurry_or_compression",
                "playspace_drag_or_height_offset",
                "fbt_drift_or_calibration"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "commandId", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "command" },
        "method": { "const": "diagnostics.clearOscAvatarCache" },
        "commandId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "const": "0.1" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "commandId", "params"],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "const": "command" },
        "method": { "const": "diagnostics.updateClientConfig" },
        "commandId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "minProperties": 2,
          "properties": {
            "schemaVersion": { "const": "0.1" },
            "cacheSizeGb": { "type": "integer", "minimum": 30, "maximum": 200 },
            "cacheExpiryDelayDays": { "type": "integer", "minimum": 30, "maximum": 365 }
          }
        }
      }
    }
  ]
}
