{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/library-download/v0.1/response",
  "type": "object", "required": ["schemaVersion", "batchId", "taskId", "productId", "revision", "state", "cancellationRequested", "recoveryDisposition", "files"], "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "batchId": { "type": "string", "pattern": "^library-download-[A-Za-z0-9_.:-]{1,100}$" },
    "taskId": { "type": "string", "pattern": "^library-download-[A-Za-z0-9_.:-]{1,100}$" },
    "productId": { "type": "string", "pattern": "^booth:[0-9]+$" }, "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["running", "succeeded", "succeeded_with_warnings", "failed", "cancelled"] },
    "cancellationRequested": { "type": "boolean" }, "recoveryDisposition": { "enum": ["none", "inspect_required"] },
    "files": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "file": {
      "type": "object", "required": ["downloadableId", "fileName", "phase", "downloadId", "errorCode", "entryId", "copyId", "artifactSha256", "replaced"], "additionalProperties": false,
      "properties": {
        "downloadableId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "fileName": { "type": "string" },
        "phase": { "enum": ["queued", "downloading", "downloaded", "inspecting", "stored", "failed", "cancelled", "unconfirmed"] },
        "downloadId": { "$ref": "#/$defs/nullableText" }, "errorCode": { "$ref": "#/$defs/nullableText" },
        "entryId": { "$ref": "#/$defs/nullableText" }, "copyId": { "$ref": "#/$defs/nullableText" },
        "artifactSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "replaced": { "type": "boolean" }
      },
      "if": { "properties": { "phase": { "const": "stored" } } },
      "then": { "properties": { "entryId": { "type": "string" }, "copyId": { "type": "string" }, "artifactSha256": { "type": "string" } } }
    }
  }
}
