{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/library-entry-metadata/v0.1/request.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "correlationId",
        "kind",
        "method",
        "params"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "query"
        },
        "method": {
          "const": "library.entryMetadata"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "entryId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "entryId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "correlationId",
        "kind",
        "method",
        "params",
        "commandId"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "command"
        },
        "method": {
          "const": "library.updateEntryMetadata"
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "entryId",
            "expectedRevision",
            "displayName",
            "productId",
            "thumbnailRef"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "entryId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "productId": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^booth:[0-9]+$"
            },
            "thumbnailRef": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^vua-img://local/[a-f0-9]{64}$"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740990
            }
          }
        }
      }
    }
  ]
}
