{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/glb-inspection/v0.1/request.schema.json",
  "title": "GlbInspectionRequestParamsV0.1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "productId"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "productId": {
          "type": "string",
          "pattern": "^booth:[1-9][0-9]{0,19}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "entryId"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  ]
}
