{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/library-intake/v0.1/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "correlationId",
    "kind",
    "method",
    "commandId",
    "params"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "command"
    },
    "method": {
      "const": "library.importFolders"
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceFolders"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "sourceFolders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\]+\\\\[^\\\\]+|/)"
          }
        },
        "autoGenerate": {
          "type": "boolean"
        }
      }
    }
  }
}
