{
  "name": "@vua/desktop",
  "version": "0.6.7",
  "private": true,
  "description": "A local-first desktop assistant for VRChat play and avatar workflows.",
  "author": "VUA Project contributors",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "pnpm --filter @vua/orchestrator-provider build && cargo build --release -p vua-provider-host -p vua-amf-provider --bins && node scripts/clean.mjs && tsc -p tsconfig.electron.json && vite build",
    "test:module-isolation": "node scripts/test-module-isolation.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "pnpm --filter @vua/orchestrator-provider build && vitest run src",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:module-isolation && pnpm check:boundary && pnpm check:i18n && pnpm check:contrast && pnpm check:leak && pnpm check:forest-leak",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:i18n": "node scripts/check-i18n.mjs && node --experimental-strip-types scripts/check-i18n-tables.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:leak": "node --experimental-strip-types scripts/check-leak.mjs",
    "check:forest-leak": "node scripts/check-forest-leak.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm build && electron .",
    "package:win": "pnpm --filter @vua/orchestrator-provider build && node scripts/build-windows-provider.mjs && tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs && vite build && install-electron && node scripts/generate-release-notices.mjs --zip && node scripts/package-windows.mjs",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "smoke:remote-permissions": "pnpm build && electron scripts/smoke-remote-permissions.mjs",
    "smoke:m2-deliverables": "pnpm build && electron scripts/smoke-m2-deliverables.mjs",
    "preview:overlay": "electron scripts/preview-overlay.mjs",
    "preview:factory": "electron scripts/preview-factory.mjs",
    "smoke:remote-content": "pnpm build && electron scripts/smoke-remote-content.mjs",
    "smoke:download-port": "pnpm build && electron scripts/smoke-download-port.mjs",
    "smoke:f4-deliverables": "pnpm build && node scripts/smoke-f4-deliverables.mjs",
    "smoke:production-review": "electron scripts/smoke-production-review.mjs",
    "smoke:amf-production": "pnpm --filter @vua/contracts build && electron scripts/smoke-amf-production.mjs",
    "smoke:ai-native": "node scripts/smoke-ai-native.mjs",
    "smoke:ai-ui": "electron scripts/smoke-ai-ui.mjs",
    "smoke:ai-bundle": "node scripts/smoke-ai-bundle.mjs",
    "smoke:first-run-ui": "electron scripts/smoke-first-run-ui.mjs",
    "smoke:amf-module": "electron scripts/smoke-amf-module.mjs",
    "smoke:help-navigation": "electron scripts/smoke-help-navigation.mjs",
    "smoke:asset-browser": "electron scripts/smoke-asset-browser.mjs",
    "smoke:booth-session": "electron scripts/smoke-booth-session.mjs",
    "smoke:startup": "electron scripts/smoke-startup.mjs",
    "smoke:system-tray": "electron scripts/smoke-system-tray.mjs",
    "smoke:library-maintenance": "electron scripts/smoke-library-maintenance.mjs",
    "smoke:dependency-clues": "electron scripts/smoke-dependency-clues.mjs",
    "smoke:library-entries": "electron scripts/smoke-dependency-clues.mjs --entries",
    "smoke:network": "electron scripts/smoke-network.mjs",
    "smoke:game-guide": "electron scripts/smoke-game-guide.mjs",
    "smoke:deployment": "pnpm --filter @vua/contracts build && electron scripts/smoke-deployment.mjs",
    "smoke:import-dialog": "electron scripts/smoke-import-dialog.mjs",
    "smoke:resource-monitor": "electron scripts/smoke-resource-monitor.mjs",
    "smoke:resource-brand": "electron scripts/smoke-resource-brand.mjs",
    "smoke:vrcft": "electron scripts/smoke-vrcft.mjs",
    "package:nsis": "pnpm --filter @vua/orchestrator-provider build && node scripts/build-windows-provider.mjs && tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs && node --experimental-strip-types scripts/build-components.mjs && install-electron && node scripts/generate-release-notices.mjs && node scripts/prepare-distribution.mjs && node scripts/package-nsis.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@vua/contracts": "workspace:*",
    "@vua/design-system": "workspace:*",
    "@vua/orchestrator-provider": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
